import numpy as np

# Fuel efficiency of different car models (in MPG)
fuel_efficiency = np.array([25, 30, 35, 40, 45])

# Calculate average fuel efficiency
average_efficiency = np.mean(fuel_efficiency)

# Calculate percentage improvement from Model 1 to Model 2
percentage_improvement = (
    (fuel_efficiency[1] - fuel_efficiency[0]) / fuel_efficiency[0]
) * 100

# Display results
print("Average fuel efficiency:", average_efficiency, "MPG")
print("Percentage improvement from Model 1 to Model 2:",
      percentage_improvement, "%")
