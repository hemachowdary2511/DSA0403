# Item prices and quantities
prices = [100, 200, 50]
quantities = [2, 1, 3]

# Discount and tax rates
discount_rate = 10
tax_rate = 5

# Calculate total cost before discount
subtotal = sum(price * quantity for price, quantity in zip(prices, quantities))

# Calculate discount
discount = (subtotal * discount_rate) / 100

# Calculate cost after discount
discounted_price = subtotal - discount

# Calculate tax
tax = (discounted_price * tax_rate) / 100

# Calculate final total cost
total_cost = discounted_price + tax

# Display results
print("Subtotal: ₹", subtotal)
print("Discount: ₹", discount)
print("Tax: ₹", tax)
print("Total Cost: ₹", total_cost)
